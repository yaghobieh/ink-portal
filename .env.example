# Marketing portal is static — leave API unset so home/docs/demos do not call Ink BE.
# VITE_INK_API_URL=http://localhost:4000

# Dev-only: sibling ../ink/dist (rebuild ink first). Do not set on Vercel.
# VITE_USE_LOCAL_INK=1
# VITE_USE_LOCAL_BEAR=1

# Optional browser OpenAI proxy for Lab. Not required for the static site.
# VITE_OPENAI_API_KEY=
