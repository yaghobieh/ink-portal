# Local ink-server. Production customers use https://cms.inkforgejs.com
VITE_INK_API_URL=http://localhost:4000
# VITE_INK_API_URL=https://cms.inkforgejs.com

# Use sibling ../ink/dist for editor variants (rebuild ink first: npm run build)
VITE_USE_LOCAL_INK=1

# Temp Lab only — browser uses Vite /openai-proxy (avoids OpenAI CORS).
# Prefer keeping the key server-side later via ink-server OPENAI_API_KEY.
VITE_OPENAI_API_KEY=
